# ============================================================
# AI chat widget (app/api/ai-chat)
# ============================================================
# Recommended: Groq — fastest, free, no credit card. Get a key at
# https://console.groq.com/keys (sign in with Google/GitHub).
# Any OpenAI-compatible endpoint works (OpenAI, Groq, Together, etc.)
AI_WIDGET_API_KEY=
AI_WIDGET_BASE_URL=https://api.groq.com/openai/v1
AI_WIDGET_MODEL=openai/gpt-oss-20b

# Max chat messages per visitor (by IP) per day — protects your API budget.
AI_WIDGET_DAILY_LIMIT=200

# ============================================================
# Rate limiting backend (app/api/rate-limit.ts)
# ============================================================
# Optional. If set, burst/daily rate limits are stored in Redis so they are
# shared correctly across multiple server instances/processes and survive
# restarts. If unset, limits fall back to in-memory counters — fine for a
# single-process deploy, but NOT correct once you run more than one
# instance behind a load balancer (each instance counts independently).
# Example: redis://default:password@localhost:6379
REDIS_URL=

# ============================================================
# Quick Request form (app/api/ai-lead) — sends submissions via email
# ============================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="produp website <no-reply@produp.com>"

# Where lead form submissions are sent.
LEAD_NOTIFY_EMAIL=

# ============================================================
# Admin panel (/admin) — everything below is REQUIRED for /admin to work
# ============================================================
# Encryption key for secrets stored in the database (SMTP password,
# Telegram bot token, AI API key). Generate with: openssl rand -hex 32
# NEVER commit the real value. Losing/rotating it makes saved secrets
# unreadable — you'd need to re-enter them in the admin panel.
ADMIN_SECRETS_KEY=

# One-time token used to create the first admin account at
# /admin/login?setup=<token>. Set it, create your account once, then you
# may remove it — the setup endpoint refuses to run again once an admin
# account exists, regardless of this value.
ADMIN_SETUP_TOKEN=

# Where the admin panel's SQLite database file lives. Defaults to
# <project>/data/admin.sqlite3 — created automatically on first run, no
# migration step needed. Point this at a persistent volume if you deploy
# with Docker.
ADMIN_DB_PATH=

# Where uploaded project photos/videos are stored on disk (one subfolder
# per project). Defaults to <project>/storage/media — created automatically.
MEDIA_STORAGE_DIR=

# IMPORTANT: both of the above need a normal writable filesystem that
# persists between requests/restarts — i.e. a regular Node.js server
# (VPS, Docker, `npm run build && npm start`), not a serverless/edge
# platform where the filesystem resets on every request.
